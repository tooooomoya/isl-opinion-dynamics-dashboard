# ---- build output (compiled classes; run.sh and the sweep scripts recompile into bin*/) ----
bin/
bin_*/
*.class
.javafiles*.txt

# ---- run output: disposable and regenerable from seed + parameters ----
# Commit the written-up conclusions in docs/report/*.md, not the raw output.
results/
logs/
*.log
docs/report/*.csv

# ---- local environments and caches ----
venv/
node_modules/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- editor / OS ----
.DS_Store
.idea/
.vscode/

# ---- images (generated plots and screenshots) ----
*.png
*.gif

# ---- local-only files ----
docs/reference/
dashboard/color_presets.local.json
